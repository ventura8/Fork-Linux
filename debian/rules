#!/usr/bin/make -f
# debian/rules - Fork for Linux (unofficial). debhelper 13 + meson; no maintainer scripts:
# packages ship code only, every piece of Wine state is created per user at first run.

export DH_VERBOSE = 1
export PYTHONDONTWRITEBYTECODE = 1

%:
	dh $@ --buildsystem=meson

# dh_auto_test runs meson test: the bridge's native C unit tests and the data checks
# (generated files current, desktop-file-validate, appstreamcli).
override_dh_auto_configure:
	dh_auto_configure -- \
		-Dbridge=enabled \
		-Dflavor=deb \
		-Dpython=/usr/bin/python3 \
		-Dfork_alias=true
