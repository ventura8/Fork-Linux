# dpkg-source options for the 3.0 (native) source package: keep build trees, CI output,
# caches and secrets out of the source tarball (the PPA builds from it).
tar-ignore = ".git"
tar-ignore = ".claude"
tar-ignore = ".cache"
tar-ignore = ".pytest_cache"
tar-ignore = ".ruff_cache"
tar-ignore = "__pycache__"
tar-ignore = "*.pyc"
tar-ignore = ".coverage"
tar-ignore = ".sonar-token"
tar-ignore = ".scannerwork"
tar-ignore = "artifacts"
tar-ignore = "logs/*.log"
tar-ignore = "logs/ci-*"
tar-ignore = "build-*"
tar-ignore = "builddir*"
tar-ignore = "obj-*"
tar-ignore = ".flatpak-builder"
