#!/usr/bin/env python3
"""Fake ``xrdb`` for tests (owned by the wine task).

Logs {"argv", "env"} to $FL_FAKE_LOG. ``-query`` prints $FL_FAKE_XRDB (the
resource database text); when that variable is unset it fails like xrdb
without a display.
"""

import json
import os
import sys
from pathlib import Path


def log_call() -> None:
    path = os.environ.get("FL_FAKE_LOG")
    if not path:
        return
    env = {key: value for key, value in os.environ.items() if key in ("DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY")}
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps({"argv": [Path(sys.argv[0]).name, *sys.argv[1:]], "env": env}) + "\n")


def main() -> int:
    log_call()
    if "FL_FAKE_XRDB" not in os.environ:
        print(f"xrdb: Can't open display '{os.environ.get('DISPLAY', '')}'", file=sys.stderr)
        return 1
    if sys.argv[1:] == ["-query"]:
        sys.stdout.write(os.environ["FL_FAKE_XRDB"])
    return 0


if __name__ == "__main__":
    sys.exit(main())
