#!/usr/bin/env python3
"""Fake ``gsettings`` for tests (owned by the wine task).

Logs {"argv", "env"} to $FL_FAKE_LOG. ``get SCHEMA KEY`` prints the value of
"SCHEMA KEY" in the JSON object $FL_FAKE_GSETTINGS (GVariant text such as
``'prefer-dark'`` or ``uint32 2``); an unknown key fails like the real tool.
Other subcommands succeed silently.
"""

import json
import os
import sys
from pathlib import Path


def log_call() -> None:
    path = os.environ.get("FL_FAKE_LOG")
    if not path:
        return
    env = {key: value for key, value in os.environ.items() if key.startswith(("XDG_", "DBUS_"))}
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps({"argv": [Path(sys.argv[0]).name, *sys.argv[1:]], "env": env}) + "\n")


def main() -> int:
    log_call()
    args = sys.argv[1:]
    if len(args) != 3 or args[0] != "get":
        return 0
    values = json.loads(os.environ.get("FL_FAKE_GSETTINGS", "{}") or "{}")
    key = f"{args[1]} {args[2]}"
    if key not in values:
        print(f"No such schema or key: {key}", file=sys.stderr)
        return 1
    print(values[key])
    return 0


if __name__ == "__main__":
    sys.exit(main())
