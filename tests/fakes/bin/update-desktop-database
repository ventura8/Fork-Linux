#!/usr/bin/env python3
"""Fake update-desktop-database for tests, owned by the integration task (rebuilding the desktop MIME cache).

Appends {"argv", "env", "cwd"} as one JSON line to $FL_FAKE_LOG and exits
with $FL_FAKE_UPDATE_DESKTOP_DATABASE_RC (default 0).
Effect: writes mimeinfo.cache into the directory given as the last argument.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

ENV_KEYS = ("DISPLAY", "WAYLAND_DISPLAY", "HOME", "LD_LIBRARY_PATH", "WINEPREFIX", "WINEDEBUG", "WINESERVER")
RC_VAR = "FL_FAKE_UPDATE_DESKTOP_DATABASE_RC"


def log(**extra: object) -> None:
    """Record this call in $FL_FAKE_LOG."""
    path = os.environ.get("FL_FAKE_LOG")
    if not path:
        return
    record = {
        "argv": [Path(sys.argv[0]).name, *sys.argv[1:]],
        "env": {key: os.environ[key] for key in ENV_KEYS if key in os.environ},
        "cwd": os.getcwd(),
        **extra,
    }
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(record) + "\n")


def main() -> int:
    log()
    target = Path(sys.argv[-1]) if len(sys.argv) > 1 else None
    if target is not None and target.is_dir():
        (target / "mimeinfo.cache").write_text("[MIME Cache]\n", encoding="utf-8")
    return int(os.environ.get(RC_VAR, "0"))


if __name__ == "__main__":
    sys.exit(main())
