/*
 * fl_launch.rc - resources of fl-launch.exe (Fork for Linux (unofficial) bridge):
 * the application manifest (app.manifest) and VERSIONINFO.
 *
 * fl_version.h is generated by the build from the repository's VERSION file
 * (the single source of the project version) and must define FL_VERSION_MAJOR,
 * FL_VERSION_MINOR, FL_VERSION_PATCH (numbers) and FL_VERSION_STR ("N.N.N").
 */
#include <windows.h>
#include "fl_version.h"

#if !defined(FL_VERSION_MAJOR) || !defined(FL_VERSION_MINOR) || !defined(FL_VERSION_PATCH) || !defined(FL_VERSION_STR)
#error "fl_version.h must define FL_VERSION_MAJOR, FL_VERSION_MINOR, FL_VERSION_PATCH and FL_VERSION_STR"
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION FL_VERSION_MAJOR, FL_VERSION_MINOR, FL_VERSION_PATCH, 0
PRODUCTVERSION FL_VERSION_MAJOR, FL_VERSION_MINOR, FL_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Fork-Linux project (unofficial)"
            VALUE "FileDescription", "Fork for Linux (unofficial) bridge: host tool launcher"
            VALUE "FileVersion", FL_VERSION_STR
            VALUE "InternalName", "fl-launch"
            VALUE "LegalCopyright", "MIT"
            VALUE "OriginalFilename", "fl-launch.exe"
            VALUE "ProductName", "Fork for Linux (unofficial) bridge"
            VALUE "ProductVersion", FL_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
