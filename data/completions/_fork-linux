    case $word in
      --) _files; return ;;
      -*=*) continue ;;
      -*) (( ${vopts[(Ie)$word]} )) && skip=1; continue ;;
    esac
    if (( ${#subs} )); then
      key=${key:+$key }$word
      _fork_linux_node "$key"
    fi
  done
