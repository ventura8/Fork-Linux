<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 ventura8 -->
<!-- Template: scripts/gen-data.py metainfo fills @APP_ID@, @APP_NAME@ and the description
     (credits.render_metainfo_paragraphs()). Add a <release> per version (AGENTS.md §4.7.2). -->
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>@APP_NAME@</name>
  <summary>Unofficial Wine wrapper for the Fork git client</summary>
  <developer id="io.github.ventura8">
    <name>ventura8</name>
  </developer>
  <description>
    @DESCRIPTION@
  </description>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <url type="homepage">https://github.com/ventura8/Fork-Linux</url>
  <url type="bugtracker">https://github.com/ventura8/Fork-Linux/issues</url>
  <url type="help">https://github.com/ventura8/Fork-Linux#readme</url>
  <categories>
    <category>Development</category>
    <category>RevisionControl</category>
  </categories>
  <keywords>
    <keyword>git</keyword>
    <keyword>wine</keyword>
    <keyword>version control</keyword>
  </keywords>
  <provides>
    <binary>fork-linux</binary>
    <binary>fork</binary>
  </provides>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.0.3" date="2026-10-14">
      <description>
        <p>Open in lists host IDEs on PATH (VS Code, Cursor, IntelliJ, …). repo fix sets core.filemode so Stage All and file diffs work under Wine.</p>
      </description>
    </release>
    <release version="1.0.2" date="2026-10-14">
      <description>
        <p>System file dialogs fixed: Linux zenity/kdialog pickers open for Fork's Open / Save / folder dialogs (HKLM CLSID registration and hand-off daemon).</p>
      </description>
    </release>
    <release version="1.0.1" date="2026-10-13">
      <description>
        <p>System file dialogs: Fork's Open / Save / folder pickers use the Linux file chooser (zenity or kdialog) by default.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-10-09">
      <description>
        <p>First public release: lazy, resumable setup of a pinned Wine runtime, .NET Framework, the Selawik interface font and the official Fork installer; menu entry, fork command and "Open in Fork" for the installed file managers; update snapshots and rollback; health check; experimental native-git bridge.</p>
      </description>
    </release>
  </releases>
</component>
