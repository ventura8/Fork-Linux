# @APP_NAME@: "@LABEL@" for Caja and PCManFM (FileManager-Actions format).
# GENERATED by fork-linux desktop install; removed by fork-linux desktop remove.
[Desktop Entry]
Type=Action
Name=@LABEL@
Tooltip=@TOOLTIP@
Icon=@APP_ID@
TargetContext=true
TargetLocation=true
Profiles=fork_linux_open;

[X-Action-Profile fork_linux_open]
Name=@LABEL@
MimeTypes=all/all;
SelectionCount==1
Exec=@EXEC@ open --from-file-manager %f
