# @APP_NAME@: "@LABEL@" for Dolphin (KDE Frameworks 5 and 6).
# GENERATED by fork-linux desktop install; removed by fork-linux desktop remove.
[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=inode/directory;all/allfiles;
Actions=forkLinuxOpen;
X-KDE-Priority=TopLevel

[Desktop Action forkLinuxOpen]
Name=@LABEL@
Icon=@APP_ID@
Exec=@EXEC@ open --from-file-manager %f
