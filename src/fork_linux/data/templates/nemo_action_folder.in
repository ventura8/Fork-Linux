# @APP_NAME@: "@LABEL@" for Nemo, on the folder a Nemo window shows (its background menu).
# GENERATED by fork-linux desktop install; removed by fork-linux desktop remove.
[Nemo Action]
Active=true
Name=@LABEL@
Comment=@TOOLTIP@
Exec=@EXEC@ open --from-file-manager %P
Icon-Name=@APP_ID@
Selection=none
Extensions=any;
Quote=double
