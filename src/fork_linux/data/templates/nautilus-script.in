#!/bin/sh
# @APP_NAME@: "@LABEL@" for Nautilus (Scripts menu).
# GENERATED by fork-linux desktop install; removed by fork-linux desktop remove.
# Nautilus runs scripts in the current folder with the selected names as
# arguments; with nothing selected the current folder itself is opened.
if [ "$#" -eq 0 ]; then
    set -- "$PWD"
fi
exec @EXEC_SH@ open --from-file-manager "$1"
