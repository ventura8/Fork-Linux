"""@APP_NAME@: "@LABEL@" for Nautilus (nautilus-python extension).

GENERATED by fork-linux desktop install; removed by fork-linux desktop remove.
Works with Nautilus 3.x (get_file_items(window, files)) and 4.x
(get_file_items(files)), for selected items and for the folder background.
"""

from __future__ import annotations

import subprocess

import gi

try:
    gi.require_version("Nautilus", "4.0")
except ValueError:
    gi.require_version("Nautilus", "3.0")
from gi.repository import GObject, Nautilus

COMMAND = @COMMAND_LITERAL@
LABEL = @LABEL_LITERAL@
TOOLTIP = @TOOLTIP_LITERAL@
ICON = @ICON_LITERAL@


def _local_path(item):
    """The local path of a Nautilus file, or None for remote locations."""
    location = item.get_location()
    return location.get_path() if location is not None else None


def _open(_menu_item, path):
    """Start fork-linux in its own session so Nautilus never waits for it."""
    subprocess.Popen(
        [*COMMAND, "open", "--from-file-manager", path],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def _menu_item(name, path):
    item = Nautilus.MenuItem(name=name, label=LABEL, tip=TOOLTIP, icon=ICON)
    item.connect("activate", _open, path)
    return item


class ForkLinuxMenuProvider(GObject.GObject, Nautilus.MenuProvider):
    """Adds the menu item; the last positional argument is the selection (or folder)."""

    def get_file_items(self, *args):
        files = args[-1]
        if len(files) != 1:
            return []
        path = _local_path(files[0])
        return [_menu_item("ForkLinux::OpenSelection", path)] if path else []

    def get_background_items(self, *args):
        path = _local_path(args[-1])
        return [_menu_item("ForkLinux::OpenFolder", path)] if path else []
