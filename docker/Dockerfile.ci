# syntax=docker/dockerfile:1.27.0
# CI image for Fork for Linux (unofficial) — compat cell: Ubuntu 26.04 (resolute), the baseline
# Image tag: fork-linux-ci-resolute:26.04
# Runs (scripts/ci-docker.sh, FL_CI_STAGE=compat FL_CI_CELL=resolute): meson build + meson test,
# py_compile and the pytest suite (no coverage floors), as an unprivileged user.
# Source is bind-mounted at /src (no COPY).
FROM ubuntu:26.04

ENV LANG=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive
# Apt packages are distro-locked by ubuntu:26.04 (no floating apt versions).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git \
    python3 python3-pytest \
    meson ninja-build gcc libc6-dev \
    desktop-file-utils appstream \
    bash zsh fish file binutils xdg-utils curl

WORKDIR /src
CMD ["./scripts/ci-docker.sh", "--inside"]
