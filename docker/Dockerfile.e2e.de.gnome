# syntax=docker/dockerfile:1.27.0
# Desktop E2E image for Fork for Linux (unofficial) — Ubuntu 26.04 with Ubuntu's GNOME 50
# Image tag: fork-linux-e2e-de-gnome:26.04
# scripts/ci-e2e-de.sh gnome [--fork] runs tests/e2e_de in here (FL_E2E_DE=gnome) as the invoking
# unprivileged user, with the source bind-mounted read-only at /src (no COPY) and one scratch
# root at /e2e. tests/e2e_de/desktops.py starts the session: dbus-daemon, mutter 50 as a headless
# Wayland compositor with its own Xwayland (mutter 50 has no X11 mode), gsd-xsettings, and
# Nautilus's FileManager1 service, with Ubuntu's own defaults (ubuntu-settings: Yaru, keyed on
# XDG_CURRENT_DESKTOP=ubuntu:GNOME), python3-nautilus for our "Open in Fork" extension and Ptyxis,
# 26.04's terminal, reached through xdg-terminal-exec. The real-Fork tier (FL_E2E_DE_FORK=1)
# downloads the managed Wine runtime, winetricks' verbs and the official Fork installer at run
# time (or copies them from a read-only local seed); nothing is baked into the image or cached,
# and only text logs leave the container (no screenshots, no binaries).
# Wine's host libraries come from the same table as `fork-linux doctor`
# (fork_linux.hostdeps, Debian names), as in docker/Dockerfile.e2e.wine.
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
# Apt packages are distro-locked by ubuntu:26.04 (no floating apt versions).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git python3 python3-pytest python3-gi curl procps file \
    xvfb xauth xdotool x11-utils x11-xserver-utils imagemagick \
    dbus-daemon dbus-bin dbus-x11 libglib2.0-bin \
    cabextract unzip 7zip fontconfig zenity \
    desktop-file-utils xdg-utils shared-mime-info \
    libfreetype6 libfontconfig1 libgnutls30t64 libx11-6 libxext6 libxrender1 libxi6 \
    libxrandr2 libxcursor1 libxcomposite1 libxinerama1 libxfixes3 libgl1 \
    libvulkan1 libdbus-1-3 libasound2t64 libpulse0 libxkbcommon0 libwayland-client0 libegl1 \
    mutter xwayland gnome-settings-daemon dconf-service dconf-cli gsettings-desktop-schemas \
    ubuntu-settings yaru-theme-gtk yaru-theme-icon \
    nautilus python3-nautilus ptyxis xdg-terminal-exec \
    xdg-desktop-portal xdg-desktop-portal-gnome xdg-desktop-portal-gtk

# There is no systemd user manager in the container: Ptyxis's agent would start every shell in a
# `systemd-run --user --scope` unit and show "Failed" in each tab; without systemd-run it starts
# the shell itself, as it does on systems without systemd.
RUN dpkg-divert --local --rename --divert /usr/bin/systemd-run.fl-e2e --add /usr/bin/systemd-run

WORKDIR /src
CMD ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests/e2e_de"]
