# syntax=docker/dockerfile:1.28.0
# Real end-to-end image for Fork for Linux (unofficial) — Ubuntu 26.04
# Image tag: fork-linux-ci-e2e-wine:26.04
# scripts/ci-e2e-wine.sh (CI) and scripts/e2e-docker.sh (local; the only way to run real
# Fork / Wine work on a developer machine, AGENTS.md hard rule 18) run FL_E2E_FORK=1 tests/e2e
# and exploration shells in here as an unprivileged user: the managed Wine runtime, winetricks
# (.NET + core fonts) and the official Fork installer are downloaded at run time (or copied
# from a read-only local seed) and never baked into the image or cached, under Xvfb with
# xdotool. Only logs leave the container (no screenshots, no binaries).
# Exploration tools: strace (with e2e-docker.sh --ptrace), x11-utils / x11-xserver-utils
# (xdpyinfo, xwininfo, xprop, xrandr), imagemagick (import), git-lfs, openssh client + server
# (ssh_sync / git-over-ssh scenarios against a local sshd). Scenario tools: zenity (the setup
# progress dialog of a launch with pending steps), weston (a headless Wayland compositor for
# the --wayland driver), xclip (reads what Fork copies, e.g. Copy Commit SHA), git-flow (Fork's Git
# Flow commands with the native-git bridge).
# fonts-noto-core / fonts-noto-cjk: the Linux fonts the font_fallback step maps WPF's
# composite font to (Cyrillic, Greek, CJK, ... in Fork's interface).
# Wine's host libraries come from the same table as `fork-linux doctor`
# (fork_linux.hostdeps, Debian names); distro Wine is not installed.
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
# Apt packages are distro-locked by ubuntu:26.04 (no floating apt versions).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git git-lfs python3 python3-pytest \
    xvfb xauth xdotool x11-utils x11-xserver-utils imagemagick \
    cabextract unzip 7zip fontconfig fonts-noto-core fonts-noto-cjk curl \
    strace openssh-client openssh-server file zenity weston xclip git-flow \
    libfreetype6 libfontconfig1 libgnutls30t64 libx11-6 libxext6 libxrender1 libxi6 \
    libxrandr2 libxcursor1 libxcomposite1 libxinerama1 libxfixes3 libgl1 \
    libvulkan1 libdbus-1-3 libasound2t64 libpulse0 libxkbcommon0 libwayland-client0 libegl1 \
    procps

WORKDIR /src
CMD ["python3", "-m", "pytest", "-q", "tests/e2e"]
