# syntax=docker/dockerfile:1.28.0
# Desktop E2E image for Fork for Linux (unofficial) — Ubuntu 26.04 with Kubuntu's KDE Plasma 6.6 on Wayland
# Image tag: fork-linux-e2e-de-kdewayland:26.04
# scripts/ci-e2e-de.sh kdewayland [--fork] runs tests/e2e_de in here (FL_E2E_DE=kdewayland) as the
# invoking unprivileged user, with the source bind-mounted read-only at /src (no COPY) and one
# scratch root at /e2e. Plasma on Wayland is Kubuntu 26.04's default session (sddm's "Plasma"):
# tests/e2e_de/desktops.py starts it as startplasma-wayland does: dbus-daemon, kwin_wayland on its
# virtual backend (one 1920x1080 output) with its own Xwayland, where X11 programs such as Wine
# run, kcminit + kded6 and Dolphin's FileManager1 service, with Kubuntu's own defaults
# (kubuntu-settings-desktop, Breeze / Breeze Dark, the plasma-applications.menu that
# kbuildsycoca6 reads); kscreen-doctor applies Display Configuration's scale as the KCM does.
# The real-Fork tier (FL_E2E_DE_FORK=1) downloads the managed Wine runtime, winetricks' verbs and
# the official Fork installer at run time (or copies them from a read-only local seed); nothing is
# baked into the image or cached, and only text logs leave the container (no screenshots, no
# binaries).
# Wine's host libraries come from the same table as `fork-linux doctor`
# (fork_linux.hostdeps, Debian names), as in docker/Dockerfile.e2e.wine.
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
# Apt packages are distro-locked by ubuntu:26.04 (no floating apt versions).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git python3 python3-pytest python3-gi curl procps file \
    xvfb xauth xdotool x11-utils x11-xserver-utils imagemagick \
    dbus-daemon dbus-bin dbus-x11 libglib2.0-bin \
    cabextract unzip 7zip fontconfig zenity \
    desktop-file-utils xdg-utils shared-mime-info \
    libfreetype6 libfontconfig1 libgnutls30t64 libx11-6 libxext6 libxrender1 libxi6 \
    libxrandr2 libxcursor1 libxcomposite1 libxinerama1 libxfixes3 libgl1 \
    libvulkan1 libdbus-1-3 libasound2t64 libpulse0 libxkbcommon0 libwayland-client0 libegl1 \
    kwin-wayland xwayland kded6 plasma-workspace plasma-session-wayland dolphin konsole kde-cli-tools \
    kio-extras libkf6config-bin libkf6service-bin libkscreen-bin breeze plasma-integration \
    frameworkintegration6 qt6-qpa-plugins qt6-wayland kubuntu-settings-desktop \
    xdg-desktop-portal xdg-desktop-portal-kde

# kwin_wayland carries the file capability cap_sys_nice (real-time scheduling), and a container
# without CAP_SYS_NICE cannot execute such a file (EPERM). A plain copy has no capabilities; kwin
# then runs with normal priority ("Failed to gain real time thread priority"), as it does without
# them on any system. kwin_wayland also wants Xwayland's socket directory to exist.
RUN install -m 0755 /usr/bin/kwin_wayland /usr/bin/kwin_wayland.fl-e2e \
    && mv -f /usr/bin/kwin_wayland.fl-e2e /usr/bin/kwin_wayland \
    && install -d -m 1777 /tmp/.X11-unix

WORKDIR /src
CMD ["python3", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests/e2e_de"]
